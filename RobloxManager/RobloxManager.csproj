<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.5pt</ApplicationDefaultFont>
    <AssemblyName>Bloxkeep</AssemblyName>
    <RootNamespace>RobloxManager</RootNamespace>
    <Product>Bloxkeep</Product>
    <!-- Shown in the exe's Properties, Details tab; build.bat passes the same name as the Publisher in Installed apps. -->
    <Company>minhhoang0122</Company>
    <Description>Encrypted Roblox account manager and launcher</Description>
    <Version>1.0.0</Version>
    <!-- WinForms ships translated resource DLLs for every language; the UI has its own strings, so keep English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lighter runtime: no ICU culture data, no background GC thread, and a GC that prefers giving memory back. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Compiled ahead of time when published (build.bat), so the app starts without compiling its own code first. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- The WebView2 package also ships its WPF control, which drags in a WindowsBase version mismatch we never load. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Windows' own text recognition (MacroOcr.cs) is called through its COM tables by hand: the Windows SDK's .NET
         projection that a windows10 target framework brings adds 57 MB to the app (measured 2026-11-02). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- GitHub repository releases are published to (build.bat passes it); empty = never looks for updates. -->
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <!-- The macro and board checks (Tests/Bloxkeep.Tests/MacroSuite.cs) drive the player and the maths directly. -->
    <InternalsVisibleTo Include="Bloxkeep.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ui.js, the small pages' ui-*.js and ui-*.css, and app.css as served (obj\ui\app.css) are built (BuildUi below), so
         they're added once they exist rather than by this list. -->
    <EmbeddedResource Include="wwwroot\*" Exclude="wwwroot\ui.js;wwwroot\ui-*.js;wwwroot\ui-*.css;wwwroot\app.css" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <!-- What's new's pictures of the headline features (whatsnew.json "image"); ".en"/".vi" in their names is not a culture. -->
    <EmbeddedResource Include="wwwroot\whatsnew\*" LogicalName="wwwroot/whatsnew/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="whatsnew.json" LogicalName="whatsnew.json" />
  </ItemGroup>

  <!--
    The parts of the interface written in React (..\ui\src) built before every build into wwwroot\ui.js (the app's page)
    and wwwroot\ui-*.js and ui-*.css (one each per small page: the tray's, a macro's panel, mini, overlay, the message
    box, the browser's top; their stylesheet is app.css's rules they can match), and app.css without comments for the
    app's page (obj\ui\app.css, served as app.css): Node.js is needed to build Bloxkeep (not to run it). The packages come
    from ..\ui\package-lock.json, installed without running any of their scripts (..\ui\.npmrc). Skipped when nothing
    they're built from changed since (the C# too: a class can come from a value the app sends).
  -->
  <ItemGroup>
    <UiSource Include="..\ui\src\**\*;..\ui\build.mjs;..\ui\package-lock.json;..\ui\tsconfig.json;wwwroot\shared.js;wwwroot\i18n.js;wwwroot\app.css;wwwroot\*.html" />
    <UiOutput Include="wwwroot\ui.js;wwwroot\ui-tray.js;wwwroot\ui-panel.js;wwwroot\ui-mini.js;wwwroot\ui-overlay.js;wwwroot\ui-dialog.js;wwwroot\ui-browser.js" />
    <UiOutput Include="wwwroot\ui-tray.css;wwwroot\ui-panel.css;wwwroot\ui-mini.css;wwwroot\ui-overlay.css;wwwroot\ui-dialog.css;wwwroot\ui-browser.css;obj\ui\app.css" />
  </ItemGroup>
  <Target Name="BuildUi" Inputs="@(UiSource);@(Compile)" Outputs="@(UiOutput)">
    <Exec Command="npm ci" WorkingDirectory="..\ui" Condition="!Exists('..\ui\node_modules\.package-lock.json')" />
    <Exec Command="node build.mjs" WorkingDirectory="..\ui" />
  </Target>
  <Target Name="EmbedUi" DependsOnTargets="BuildUi" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="@(UiOutput)" LogicalName="wwwroot/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
