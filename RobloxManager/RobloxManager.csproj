<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.5pt</ApplicationDefaultFont>
    <AssemblyName>Bloxkeep</AssemblyName>
    <RootNamespace>RobloxManager</RootNamespace>
    <Product>Bloxkeep</Product>
    <!-- Shown in the exe's Properties, Details tab; build.bat passes the same name as the Publisher in Installed apps. -->
    <Company>minhhoang0122</Company>
    <Description>Encrypted Roblox account manager and launcher</Description>
    <Version>1.0.0</Version>
    <!-- WinForms ships translated resource DLLs for every language; the UI has its own strings, so keep English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lighter runtime: no ICU culture data, no background GC thread, and a GC that prefers giving memory back. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Compiled ahead of time when published (build.bat), so the app starts without compiling its own code first. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- The WebView2 package also ships its WPF control, which drags in a WindowsBase version mismatch we never load. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- GitHub repository releases are published to (build.bat passes it); empty = never looks for updates. -->
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ui.js is built (BuildUi below), so it's added once it exists rather than by this list. -->
    <EmbeddedResource Include="wwwroot\*" Exclude="wwwroot\ui.js" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="whatsnew.json" LogicalName="whatsnew.json" />
  </ItemGroup>

  <!--
    The parts of the interface written in React (..\ui\src) built into wwwroot\ui.js before every build: Node.js is
    needed to build Bloxkeep (not to run it). The packages come from ..\ui\package-lock.json, installed without running
    any of their scripts (..\ui\.npmrc). Skipped when nothing in ..\ui changed since ui.js was built.
  -->
  <ItemGroup>
    <UiSource Include="..\ui\src\**\*;..\ui\build.mjs;..\ui\package-lock.json;..\ui\tsconfig.json" />
  </ItemGroup>
  <Target Name="BuildUi" Inputs="@(UiSource)" Outputs="wwwroot\ui.js">
    <Exec Command="npm ci" WorkingDirectory="..\ui" Condition="!Exists('..\ui\node_modules\.package-lock.json')" />
    <Exec Command="node build.mjs" WorkingDirectory="..\ui" />
  </Target>
  <Target Name="EmbedUi" DependsOnTargets="BuildUi" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\ui.js" LogicalName="wwwroot/ui.js" />
    </ItemGroup>
  </Target>

</Project>
