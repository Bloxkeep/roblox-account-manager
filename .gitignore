# Build output
bin/
obj/
artifacts/
dist/

# Local vault / user data (never commit)
*.rmv
*.rmv.bak
error.log
*.log
prefs.json
AccountData.json

# Secrets (never commit): signing material, and the webhook links and tokens a local run of the Cloudflare Workers
# (services/Feedback/worker, services/RobloxWatch/worker: `wrangler dev`) or of the watch scripts reads
*.pfx
*.snk
.dev.vars
.dev.vars.*
.env
.env.*

# Cloudflare wrangler's local state
.wrangler/

# Test runs (the interface checks write what the page showed, screenshots and this PC's layout copies to Tests/ui/out)
TestResults/
*.trx
Tests/ui/out/
Tests/perf/out/

# Discord message samples the discord test suite writes for ui/dev/discord-preview.html
ui/dev/discord-samples*.json
ui/dev/discord-samples/

# Python (services/DomainWatch, services/RobloxWatch)
__pycache__/
*.pyc
.venv/

# Node: the React parts' packages (ui/package-lock.json says which), and what ui/build.mjs builds from ui/src
node_modules/
RobloxManager/wwwroot/ui.js

# Claude Code: local settings, launch configurations and worktrees
.claude/

# IDE / OS
.vs/
.vscode/
.idea/
*.user
*.swp
*.tmp
Thumbs.db
desktop.ini
.DS_Store
